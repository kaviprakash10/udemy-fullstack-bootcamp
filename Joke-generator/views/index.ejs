<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>⚡ JOKE POP! | Neo-Brutalist Joke Generator</title>
    
    <!-- Tailwind CSS v4 CDN -->
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
    
    <!-- Google Fonts: Space Grotesk & Fredoka -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Space+Grotesk:wght@500;700;900&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body { 
            font-family: 'Space Grotesk', sans-serif;
            background-color: #FEF08A;
        }
        h1, h2, h3, .font-pop {
            font-family: 'Fredoka', cursive, sans-serif;
        }
    </style>
</head>
<body class="min-h-full flex flex-col justify-between bg-[#FEF08A] text-black antialiased selection:bg-[#EC4899] selection:text-white">

    <!-- Top Pop-Art Header Bar -->
    <header class="w-full bg-white border-b-4 border-black p-4 shadow-[0px_4px_0px_0px_rgba(0,0,0,1)] sticky top-0 z-50">
        <div class="max-w-4xl mx-auto flex items-center justify-between">
            <div class="flex items-center space-x-2">
                <div class="bg-[#7C3AED] text-white p-2 rounded-lg border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                    <i class="fa-solid fa-face-laugh-squint text-xl"></i>
                </div>
                <span class="font-pop font-extrabold text-2xl tracking-wide uppercase text-black">
                    JOKE<span class="text-[#7C3AED]">POP!</span>
                </span>
            </div>

            <div class="flex items-center space-x-2">
                <span class="bg-[#EC4899] text-white text-xs font-black uppercase px-3 py-1 rounded-full border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hidden sm:inline-block">
                    ⚡ Express + Axios API
                </span>
            </div>
        </div>
    </header>

    <!-- Main Centered Layout -->
    <main class="flex-1 flex items-center justify-center p-4 sm:p-6 my-6">
        <div class="w-full max-w-xl mx-auto space-y-6">
            
            <!-- Controls & Options Card Component -->
            <section class="bg-white border-4 border-black rounded-3xl p-6 sm:p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] space-y-6">
                
                <div class="flex items-center justify-between border-b-4 border-black pb-4">
                    <h2 class="font-pop text-2xl font-black uppercase tracking-tight flex items-center gap-2">
                        <i class="fa-solid fa-sliders text-[#7C3AED]"></i> Customize Joke
                    </h2>
                    <span class="bg-yellow-300 text-black text-xs font-black uppercase px-2.5 py-1 rounded-lg border-2 border-black">
                        API Mode
                    </span>
                </div>

                <form action="/get-joke" method="POST" class="space-y-5">
                    
                    <!-- Search Keyword & Custom Name Input Fields -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label for="search" class="block font-black text-xs uppercase tracking-wider mb-1.5">
                                🔍 Search Keyword
                            </label>
                            <input 
                                type="text" 
                                id="search" 
                                name="search" 
                                placeholder="e.g. java, doctor..."
                                value="<%= locals.query ? locals.query.search : '' %>"
                                class="w-full bg-slate-50 border-3 border-black rounded-xl p-3 font-bold text-sm text-black placeholder-slate-400 focus:outline-none focus:bg-yellow-100 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all"
                            >
                        </div>

                        <div>
                            <label for="customName" class="block font-black text-xs uppercase tracking-wider mb-1.5">
                                👤 Personalize Name
                            </label>
                            <input 
                                type="text" 
                                id="customName" 
                                name="customName" 
                                placeholder="e.g. Alex, Bob..."
                                value="<%= locals.query ? locals.query.customName : '' %>"
                                class="w-full bg-slate-50 border-3 border-black rounded-xl p-3 font-bold text-sm text-black placeholder-slate-400 focus:outline-none focus:bg-yellow-100 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all"
                            >
                        </div>
                    </div>

                    <!-- Category Chips -->
                    <div>
                        <label class="block font-black text-xs uppercase tracking-wider mb-2">
                            🏷️ Category Filter
                        </label>
                        <div class="flex flex-wrap gap-2">
                            <% 
                                const categories = ['Any', 'Programming', 'Misc', 'Dark', 'Pun', 'Spooky', 'Christmas']; 
                                const activeCat = locals.query ? locals.query.category : 'Any';
                            %>
                            <% categories.forEach(cat => { %>
                                <label class="cursor-pointer">
                                    <input type="radio" name="category" value="<%= cat %>" <%= activeCat === cat ? 'checked' : '' %> class="peer sr-only">
                                    <span class="inline-block px-3 py-1.5 rounded-xl font-black text-xs uppercase bg-slate-100 text-black border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] peer-checked:bg-[#7C3AED] peer-checked:text-white peer-checked:shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:bg-yellow-200 transition-all">
                                        <%= cat %>
                                    </span>
                                </label>
                            <% }); %>
                        </div>
                    </div>

                    <!-- Format & Blacklist -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-1">
                        <div>
                            <label for="type" class="block font-black text-xs uppercase tracking-wider mb-1.5">
                                🎭 Format
                            </label>
                            <% const activeType = locals.query ? locals.query.type : 'any'; %>
                            <select id="type" name="type" class="w-full bg-slate-50 border-3 border-black rounded-xl p-2.5 font-bold text-xs text-black focus:outline-none shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
                                <option value="any" <%= activeType === 'any' ? 'selected' : '' %>>Any Type</option>
                                <option value="single" <%= activeType === 'single' ? 'selected' : '' %>>Single Line</option>
                                <option value="twopart" <%= activeType === 'twopart' ? 'selected' : '' %>>Two-Part</option>
                            </select>
                        </div>

                        <div class="sm:col-span-2">
                            <label class="block font-black text-xs uppercase tracking-wider mb-1.5">
                                🚫 Blacklist Flags
                            </label>
                            <% 
                                const activeBlacklists = locals.query && locals.query.blacklists ? locals.query.blacklists : ['nsfw', 'racist', 'sexist', 'explicit'];
                                const flags = ['nsfw', 'religious', 'political', 'racist', 'sexist', 'explicit'];
                            %>
                            <div class="grid grid-cols-3 gap-1.5">
                                <% flags.forEach(flag => { %>
                                    <label class="flex items-center space-x-1.5 font-bold text-xs text-black cursor-pointer">
                                        <input 
                                            type="checkbox" 
                                            name="blacklists" 
                                            value="<%= flag %>" 
                                            <%= activeBlacklists.includes(flag) ? 'checked' : '' %> 
                                            class="w-4 h-4 border-2 border-black accent-[#7C3AED]"
                                        >
                                        <span class="capitalize"><%= flag %></span>
                                    </label>
                                <% }); %>
                            </div>
                        </div>
                    </div>

                    <!-- Main Action Button ("Next Joke" / "Generate Joke") -->
                    <button 
                        type="submit" 
                        class="w-full bg-[#7C3AED] hover:bg-[#6D28D9] text-white font-pop font-black text-lg uppercase tracking-wider py-4 px-6 rounded-2xl border-4 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] active:translate-x-1 active:translate-y-1 active:shadow-none transition-all flex items-center justify-center gap-2 cursor-pointer mt-2"
                    >
                        <i class="fa-solid fa-bolt text-yellow-300"></i>
                        <span>Generate Joke</span>
                    </button>
                </form>
            </section>

            <!-- Main Joke Card Display Container (Pure White Neo-Brutalism Surface) -->
            <% if (locals.data) { %>
                <section class="bg-white border-4 border-black rounded-3xl p-6 sm:p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] space-y-6 transition-all">
                    
                    <!-- Card Badges Header -->
                    <div class="flex flex-wrap items-center justify-between gap-2 border-b-4 border-black pb-4">
                        <div class="flex items-center gap-2">
                            <span class="bg-cyan-300 text-black font-black text-xs uppercase px-3 py-1 rounded-xl border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                                🏷️ <%= locals.data.category %>
                            </span>
                            <span class="bg-slate-100 text-black font-mono font-bold text-xs px-2.5 py-1 rounded-xl border-2 border-black">
                                ID: #<%= locals.data.id %>
                            </span>
                        </div>

                        <% if (locals.data.safe) { %>
                            <span class="bg-emerald-300 text-black font-black text-xs uppercase px-2.5 py-1 rounded-xl border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                                🛡️ Safe
                            </span>
                        <% } %>
                    </div>

                    <!-- Joke Question & Punchline Display -->
                    <div class="py-2 space-y-4">
                        <% if (locals.data.type === 'single') { %>
                            <!-- Single Line Joke Placeholder / Text -->
                            <p class="font-pop font-bold text-xl sm:text-2xl text-black leading-snug">
                                "<%= locals.data.joke %>"
                            </p>
                        <% } else if (locals.data.type === 'twopart') { %>
                            <!-- Two Part Setup & Delivery -->
                            <div class="space-y-4">
                                <div class="bg-yellow-100 p-4 rounded-2xl border-3 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
                                    <span class="font-black text-xs uppercase text-[#7C3AED] block mb-1">❓ The Question</span>
                                    <p class="font-pop font-bold text-lg sm:text-xl text-black leading-snug">
                                        <%= locals.data.setup %>
                                    </p>
                                </div>

                                <div>
                                    <button 
                                        type="button" 
                                        id="revealBtn" 
                                        onclick="revealPunchline()"
                                        class="bg-amber-400 hover:bg-amber-300 text-black font-black text-sm uppercase py-3 px-5 rounded-xl border-3 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:translate-x-1 active:translate-y-1 active:shadow-none transition-all flex items-center gap-2 cursor-pointer"
                                    >
                                        <i class="fa-solid fa-eye"></i>
                                        <span>Reveal Punchline</span>
                                    </button>

                                    <div id="punchlineBox" class="hidden mt-3 bg-[#EC4899] text-white p-4 rounded-2xl border-3 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
                                        <span class="font-black text-xs uppercase text-yellow-200 block mb-1">💡 The Punchline</span>
                                        <p class="font-pop font-extrabold text-lg sm:text-xl leading-snug">
                                            <%= locals.data.delivery %>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <!-- Action Buttons Toolbar -->
                    <div class="pt-4 border-t-4 border-black flex flex-wrap items-center justify-between gap-3">
                        
                        <!-- Secondary Action Button ("Like / Favorite / Copy") -->
                        <div class="flex items-center gap-2">
                            <button 
                                type="button" 
                                id="likeBtn" 
                                onclick="toggleFavorite()"
                                class="bg-[#EC4899] hover:bg-[#DB2777] text-white font-black text-xs uppercase py-2.5 px-4 rounded-xl border-3 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all flex items-center gap-1.5 cursor-pointer"
                            >
                                <i class="fa-solid fa-heart" id="heartIcon"></i>
                                <span id="likeBtnText">Favorite</span>
                            </button>

                            <button 
                                type="button" 
                                onclick="copyJokeText()" 
                                class="bg-white hover:bg-slate-100 text-black font-black text-xs uppercase py-2.5 px-4 rounded-xl border-3 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all flex items-center gap-1.5 cursor-pointer"
                            >
                                <i class="fa-regular fa-copy"></i>
                                <span id="copyBtnText">Copy</span>
                            </button>
                        </div>

                        <!-- Next Joke Button Form -->
                        <form action="/get-joke" method="POST">
                            <input type="hidden" name="category" value="<%= locals.query.category %>">
                            <input type="hidden" name="type" value="<%= locals.query.type %>">
                            <input type="hidden" name="search" value="<%= locals.query.search %>">
                            <input type="hidden" name="customName" value="<%= locals.query.customName %>">
                            <% if (locals.query.blacklists) { %>
                                <% locals.query.blacklists.forEach(flag => { %>
                                    <input type="hidden" name="blacklists" value="<%= flag %>">
                                <% }); %>
                            <% } %>
                            <button 
                                type="submit" 
                                class="bg-[#7C3AED] hover:bg-[#6D28D9] text-white font-black text-xs uppercase py-2.5 px-4 rounded-xl border-3 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all flex items-center gap-1.5 cursor-pointer"
                            >
                                <i class="fa-solid fa-rotate-right"></i>
                                <span>Next Joke</span>
                            </button>
                        </form>
                    </div>
                </section>
            <% } else if (locals.error) { %>
                <!-- Error Box Component -->
                <section class="bg-rose-400 border-4 border-black rounded-3xl p-6 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] text-black font-bold flex items-start gap-3">
                    <i class="fa-solid fa-triangle-exclamation text-2xl mt-0.5"></i>
                    <div>
                        <h3 class="font-pop font-black text-lg uppercase">Oops! Query Exception</h3>
                        <p class="text-sm font-semibold mt-1"><%= locals.error %></p>
                    </div>
                </section>
            <% } %>

        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t-4 border-black p-4 text-center text-xs font-bold uppercase">
        &copy; <%= new Date().getFullYear() %> JOKEPOP! — Built with Express.js, Axios, EJS & Tailwind CSS
    </footer>

    <!-- Client Interactivity Script -->
    <script>
        function revealPunchline() {
            const punchlineBox = document.getElementById('punchlineBox');
            const revealBtn = document.getElementById('revealBtn');
            if (punchlineBox && revealBtn) {
                punchlineBox.classList.remove('hidden');
                revealBtn.style.display = 'none';
            }
        }

        function toggleFavorite() {
            const heartIcon = document.getElementById('heartIcon');
            const likeBtnText = document.getElementById('likeBtnText');
            if (likeBtnText) {
                if (likeBtnText.textContent === 'Favorite') {
                    likeBtnText.textContent = 'Favorited!';
                    heartIcon.className = 'fa-solid fa-heart text-yellow-300';
                } else {
                    likeBtnText.textContent = 'Favorite';
                    heartIcon.className = 'fa-solid fa-heart';
                }
            }
        }

        function copyJokeText() {
            let textToCopy = '';
            <% if (locals.data) { %>
                <% if (locals.data.type === 'single') { %>
                    textToCopy = <%- JSON.stringify(locals.data.joke || '') %>;
                <% } else if (locals.data.type === 'twopart') { %>
                    textToCopy = <%- JSON.stringify((locals.data.setup || '') + '\n\n' + (locals.data.delivery || '')) %>;
                <% } %>
            <% } %>

            if (textToCopy) {
                navigator.clipboard.writeText(textToCopy).then(() => {
                    const btnText = document.getElementById('copyBtnText');
                    if (btnText) {
                        const orig = btnText.textContent;
                        btnText.textContent = 'Copied!';
                        setTimeout(() => btnText.textContent = orig, 2000);
                    }
                });
            }
        }
    </script>
</body>
</html>
