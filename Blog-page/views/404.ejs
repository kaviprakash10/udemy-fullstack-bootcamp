<%- include('partials/head', { pageTitle: '404 - Page Not Found' }) %>
<%- include('partials/navbar') %>

<main class="main-content container text-center">

  <div class="error-404-box">
    <div class="error-code">404</div>
    <h2>Page Not Found</h2>
    <p class="error-message"><%= typeof message !== 'undefined' ? message : 'The page or article you are looking for does not exist.' %></p>
    <a href="/" class="btn btn-primary btn-lg"><i class="fa-solid fa-house"></i> Return to Home Feed</a>
  </div>

</main>

<%- include('partials/footer') %>
