<%- include('partials/head', { pageTitle: 'Create New Post' }) %>
<%- include('partials/navbar') %>

<main class="main-content container form-container">

  <div class="form-header">
    <a href="/" class="back-link"><i class="fa-solid fa-arrow-left"></i> Back to feed</a>
    <h1 class="form-title">Create New Article</h1>
    <p class="form-subtitle">Share your ideas, essays, or technical breakdowns with the world.</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="form-error-alert">
      <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
    </div>
  <% } %>

  <form action="/posts" method="POST" class="post-form card-form">
    
    <div class="form-group">
      <label for="title" class="form-label">Article Title <span class="required">*</span></label>
      <input 
        type="text" 
        id="title" 
        name="title" 
        class="form-control form-control-lg" 
        placeholder="e.g., How to Think Clearly in the Age of Information Overload" 
        value="<%= typeof formData !== 'undefined' && formData.title ? formData.title : '' %>"
        required 
        autofocus
      >
    </div>

    <div class="form-group">
      <label for="subtitle" class="form-label">Subtitle / Deck</label>
      <input 
        type="text" 
        id="subtitle" 
        name="subtitle" 
        class="form-control" 
        placeholder="A quick 1-sentence summary of the main premise..."
        value="<%= typeof formData !== 'undefined' && formData.subtitle ? formData.subtitle : '' %>"
      >
    </div>

    <div class="form-grid-2">
      <div class="form-group">
        <label for="author" class="form-label">Author Name</label>
        <div class="input-icon-wrapper">
          <i class="fa-regular fa-user input-icon"></i>
          <input 
            type="text" 
            id="author" 
            name="author" 
            class="form-control icon-indent" 
            placeholder="e.g. Paul Graham"
            value="<%= typeof formData !== 'undefined' && formData.author ? formData.author : 'Kaviprakash S' %>"
          >
        </div>
      </div>

      <div class="form-group">
        <label for="category" class="form-label">Category / Topic</label>
        <div class="input-icon-wrapper">
          <i class="fa-solid fa-tag input-icon"></i>
          <input 
            type="text" 
            id="category" 
            name="category" 
            list="categoryOptions" 
            class="form-control icon-indent" 
            placeholder="e.g., Essays, Engineering, Design"
            value="<%= typeof formData !== 'undefined' && formData.category ? formData.category : 'Essays' %>"
          >
          <datalist id="categoryOptions">
            <option value="Essays">
            <option value="Engineering">
            <option value="Design">
            <option value="Philosophy">
            <option value="Technology">
          </datalist>
        </div>
      </div>
    </div>

    <div class="form-group">
      <label for="coverImage" class="form-label">Cover Image URL</label>
      <div class="input-icon-wrapper">
        <i class="fa-regular fa-image input-icon"></i>
        <input 
          type="url" 
          id="coverImage" 
          name="coverImage" 
          class="form-control icon-indent" 
          placeholder="https://images.unsplash.com/photo-..."
          value="<%= typeof formData !== 'undefined' && formData.coverImage ? formData.coverImage : '' %>"
        >
      </div>
      <small class="form-help">Leave empty for an automatic high-resolution cover image.</small>
    </div>

    <div class="form-group">
      <div class="label-with-counter">
        <label for="content" class="form-label">Article Body <span class="required">*</span></label>
        <span class="word-counter" id="wordCounter">0 words (1 min read)</span>
      </div>
      <textarea 
        id="content" 
        name="content" 
        rows="14" 
        class="form-control text-content" 
        placeholder="Write your article here... Supports section headers with '### Header Title'"
        required
      ><%= typeof formData !== 'undefined' && formData.content ? formData.content : '' %></textarea>
    </div>

    <div class="form-actions">
      <a href="/" class="btn btn-secondary">Cancel</a>
      <button type="submit" class="btn btn-primary btn-lg">
        <i class="fa-solid fa-paper-plane"></i> Publish Article
      </button>
    </div>

  </form>

</main>

<%- include('partials/footer') %>
